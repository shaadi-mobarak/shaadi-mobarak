NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/shaadi_mobarak
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# OTP delivery (email via SMTP): configure only after the owner approves a provider.
# Leave empty until then; OTP requests return 503 and no code is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Test-only: OTP_TEST_MODE=test lets integration tests verify the OTP flow
# without a real provider. It is ignored in production. Never set it on Render.
OTP_TEST_MODE=

# Payment providers: configure only after owner approves merchant credentials.
# Leave empty until then; payments stay in manual-approval mode.
BKASH_APP_KEY=
NAGAD_MERCHANT_ID=
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=

# Upload storage: "local" (default, Render ephemeral disk — files may be lost on
# redeploy). For permanent photos an S3-compatible object store is required;
# the S3 driver is not implemented yet, so do not set STORAGE_DRIVER=s3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
